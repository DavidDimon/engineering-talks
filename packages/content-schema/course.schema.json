{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DavidDimon/engineering-talks/course.schema.json",
  "title": "Engineering Talks course manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "slug",
    "title",
    "description",
    "format",
    "language",
    "topics",
    "status",
    "sourceUrl",
    "provider",
    "role",
    "period",
    "lessons"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "course" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "format": { "const": "training" },
    "language": { "type": "string", "minLength": 2 },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["draft", "published", "archived"] },
    "sourceUrl": { "type": "string", "format": "uri" },
    "historicalNotice": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startYear", "endYear"],
      "properties": {
        "startYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "endYear": { "type": "integer", "minimum": 2000, "maximum": 2100 }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "slug", "title", "topics"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
