{
  "name": "@engineering-talks/content-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "nx": {
    "name": "content-schema",
    "tags": [
      "scope:shared",
      "type:library"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/packages/content-schema"
        ]
      }
    }
  }
}
