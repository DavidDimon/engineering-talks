{
  "name": "@engineering-talks/talk-engineering-talks-intro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "slidev build --base /engineering-talks/talks/engineering-talks-intro/ --out ../../dist/talks/engineering-talks-intro --without-notes",
