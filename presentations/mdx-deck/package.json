{
  "name": "@engineering-talks/presentation-mdx-deck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../tools/pages/build-bilingual-presentation.mjs mdx-deck",
    "dev": "slidev --open",
    "validate": "tsx ../../tools/content/src/cli.ts validate --root ../.. --file presentations/mdx-deck/metadata.json"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "tsx": "4.23.15",
    "vue": "3.5.44"
  },
  "nx": {
    "name": "talk-mdx-deck",
    "tags": [
      "scope:presentation",
      "type:presentation",
      "format:talk"
    ],
    "implicitDependencies": [
      "content-schema",
      "content-tools"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/presentations/mdx-deck"
        ]
      }
    }
  }
}
