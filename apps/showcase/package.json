{
  "name": "@engineering-talks/showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm run dev:prepare && vite",
    "dev:prepare": "node ../../tools/pages/build-bilingual-presentation.mjs mdx-deck flutter monorepos-and-core-components state-management software-testing && node ../../courses/awari-front-end/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@engineering-talks/content-schema": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "nx": {
    "name": "showcase",
    "tags": [
      "scope:showcase",
      "type:app"
    ],
    "implicitDependencies": [
      "content-tools"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/apps/showcase"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "content-tools:build"
        ]
      }
    }
  }
}
